#!/usr/bin/env bash
# rex-reviewer: set up rex-reviewer, and run its actions from a shell. The
# actions run in Rex (`rex do`) or, with host = "herdr" in the config, under
# LuaJIT (scripts/cli.lua).
set -euo pipefail

# The checkout this script lives in, following symlinks.
src=${BASH_SOURCE[0]}
while [[ -L $src ]]; do
	dir=$(cd -P "$(dirname "$src")" && pwd)
	src=$(readlink "$src")
	[[ $src == /* ]] || src=$dir/$src
done
root=$(cd -P "$(dirname "$src")/.." && pwd)

config_dir="$HOME/.config/rex-reviewer"
agent_label="io.github.captjt.rex-reviewer"
agent_plist="$HOME/Library/LaunchAgents/$agent_label.plist"

usage() {
	cat <<EOF
rex-reviewer: agent PR reviews in Rex or Herdr.

Setup:
  rex-reviewer setup           create the config, and show the line for Rex's init.lua
  rex-reviewer host            the host in the config: rex or herdr
  rex-reviewer doctor          check the config, the tools, and the repos
  rex-reviewer launch-agent    keep the watcher running: start it at login and
                               repair it every 5 minutes (--remove to undo)
  rex-reviewer app [--login]   build and open the menu bar app; --login also
                               opens it at login

The watcher:
  rex-reviewer up | down       start or stop it
  rex-reviewer pause | resume  stop or resume starting new rounds
  rex-reviewer check           check GitHub now
  rex-reviewer status          every PR it knows about
  rex-reviewer backfill-tokens [save=true] [also=PATH]
                               count the tokens of PRs reviewed before
                               rex-reviewer counted them; a dry run unless
                               save=true (see scripts/backfill-tokens.lua)

A round (add a repo as owner/name when more than one is configured):
  rex-reviewer preview PR [REPO]   render the checked review
  rex-reviewer post PR [REPO]      post it
  rex-reviewer dismiss PR [REPO]   end the round without posting
  rex-reviewer focus PR [REPO]     show its tab in the Rex or Herdr app
  rex-reviewer pickup PR [REPO]    review a PR that didn't request you
  rex-reviewer replay PR [REPO]    what the rules would have done on its history
  rex-reviewer start PR [REPO]     start its next round now (after reviewer_prep)

Any action, by name:
  rex-reviewer do ACTION [key=value ...] [--json]
                                   such as: do reviewer_post item=pr/acme/api/12/2

The checkout: $root
EOF
}

die() {
	printf 'rex-reviewer: %s\n' "$*" >&2
	exit 1
}

need_rex() {
	command -v rex >/dev/null || die "rex isn't on PATH. Install Rex, or add its CLI to PATH."
}

# Sets args to pr=N, and repo=owner/name when given.
pr_args() {
	[[ ${1:-} =~ ^[0-9]+$ ]] || die "give a PR number"
	args=("pr=$1")
	[[ -z ${2:-} ]] || args+=("repo=$2")
}

need_luajit() {
	command -v luajit >/dev/null || die "luajit isn't on PATH. On Herdr, rex-reviewer runs under LuaJIT: brew install luajit."
}

# The host in the config. Reading it takes LuaJIT; without it, Rex.
host() {
	if command -v luajit >/dev/null; then
		luajit "$root/scripts/cli.lua" --host 2>/dev/null || echo rex
	else
		echo rex
	fi
}

# Run an action, or a script with key=value args, on the config's host.
act() {
	if [[ $(host) == herdr ]]; then
		need_luajit
		luajit "$root/scripts/cli.lua" "$@"
	else
		need_rex
		rex 'do' "$@"
	fi
}

setup() {
	mkdir -p "$config_dir/briefs"
	if [[ -f $config_dir/config.lua ]]; then
		echo "config: $config_dir/config.lua (kept)"
	else
		cp "$root/examples/config.lua" "$config_dir/config.lua"
		echo "config: created $config_dir/config.lua from the example. Add your repos to it."
	fi
	if [[ $(host) == herdr ]]; then
		echo
		echo "host = \"herdr\" in the config: the actions run under LuaJIT, and nothing loads in Rex."
		echo "Then: rex-reviewer doctor, and rex-reviewer up."
		return
	fi
	local line="dofile(\"$root/init.lua\")"
	local init="$HOME/.config/rex/init.lua"
	if [[ -f $init ]] && grep -qF "$root/init.lua" "$init"; then
		echo "init.lua: already loads rex-reviewer"
	else
		echo
		echo "Add this line to $init, then run: rex config reload"
		echo
		echo "  $line"
	fi
	echo
	echo "Then: rex-reviewer doctor, and rex-reviewer up."
}

doctor() {
	local out
	if [[ $(host) == herdr ]]; then
		out=$(act reviewer_doctor --json) || die "reviewer_doctor failed."
	else
		need_rex
		out=$(rex 'do' reviewer_doctor --json) || die "reviewer_doctor failed. Is rex-reviewer loaded from init.lua? Run rex-reviewer setup."
	fi
	jq -r '.checks[] | (if .ok then "ok   " else "FAIL " end) + .check + ": " + (.detail // "")' <<<"$out"
	jq -e .ok <<<"$out" >/dev/null
}

launch_agent() {
	if [[ ${1:-} == --remove ]]; then
		launchctl bootout "gui/$(id -u)/$agent_label" 2>/dev/null || true
		rm -f "$agent_plist"
		echo "removed $agent_plist"
		return
	fi
	local -a program
	local path_env=""
	if [[ $(host) == herdr ]]; then
		need_luajit
		program=("$root/bin/rex-reviewer" up --auto)
		path_env="  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>"
	else
		need_rex
		program=("$(command -v rex)" do reviewer_up auto=true)
	fi
	local args="" a
	for a in "${program[@]}"; do
		args+="    <string>$a</string>
"
	done
	mkdir -p "$(dirname "$agent_plist")" "$HOME/Library/Logs"
	cat >"$agent_plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$agent_label</string>
  <key>ProgramArguments</key>
  <array>
$args  </array>
$path_env
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>300</integer>
  <key>StandardOutPath</key>
  <string>$HOME/Library/Logs/rex-reviewer.log</string>
  <key>StandardErrorPath</key>
  <string>$HOME/Library/Logs/rex-reviewer.log</string>
</dict>
</plist>
EOF
	launchctl bootout "gui/$(id -u)/$agent_label" 2>/dev/null || true
	launchctl bootstrap "gui/$(id -u)" "$agent_plist"
	echo "installed $agent_plist: reviewer_up at login and every 5 minutes"
}

cmd=${1:-help}
shift || true
case $cmd in
setup) setup ;;
doctor) doctor ;;
launch-agent) launch_agent "$@" ;;
app)
	"$root/menubar/build.sh"
	if [[ ${1:-} == --login ]]; then
		"$HOME/Applications/Rex Reviewer.app/Contents/MacOS/RexReviewer" --open-at-login on
	fi
	;;
up)
	if [[ ${1:-} == --auto ]]; then act reviewer_up auto=true; else act reviewer_up; fi
	;;
down) act reviewer_down ;;
pause) act reviewer_pause ;;
resume) act reviewer_resume ;;
check) act reviewer_check ;;
status) act reviewer_status --json | jq . ;;
preview)
	pr_args "$@"
	out=$(act reviewer_preview "${args[@]}" --json)
	jq -r .preview <<<"$out"
	;;
post | dismiss | focus | pickup)
	pr_args "$@"
	act "reviewer_$cmd" "${args[@]}"
	;;
start | replay)
	pr_args "$@"
	act "$root/scripts/$cmd.lua" "${args[@]}"
	;;
do)
	[[ $# -gt 0 ]] || die "give an action, such as: do reviewer_status"
	act "$@"
	;;
request)
	# What an agent on Herdr runs, from a round's worktree: the watcher runs
	# the action for it. See lua/rex_reviewer/requests.lua.
	need_luajit
	PWD=$(pwd) luajit "$root/scripts/cli.lua" --request "$@"
	;;
host) host ;;
backfill-tokens) act "$root/scripts/backfill-tokens.lua" "$@" | jq . ;;
help | -h | --help) usage ;;
*)
	usage >&2
	exit 1
	;;
esac
